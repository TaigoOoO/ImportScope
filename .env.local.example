# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=

# Database (Supabase connection string, pooled)
DATABASE_URL=

# App
# ATENÇÃO ao fazer deploy: troque isto pela URL real do seu deploy na
# Vercel (ex: https://seu-projeto.vercel.app). Se este valor ficar como
# "http://localhost:3000" nas variáveis de ambiente da Vercel (em vez de
# só aqui no arquivo de exemplo local), o magic link de login e o
# checkout do Stripe vão redirecionar para localhost em produção — o
# fallback no código (lib/site-url.ts) usa window.location.origin no
# navegador, mas uma env var explicitamente errada ainda tem prioridade
# sobre esse fallback no lado do servidor (checkout, portal, emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron (lembrete de renovação — opcional, protege a rota de cron)
CRON_SECRET=

# Cache + rate limiting (opcional — sem isso, cai num fallback em memória
# que funciona localmente mas não é compartilhado entre instâncias serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 1688 (opcional — ver comentário em lib/integrations/1688-scraper.ts.
# Sem uma chave configurada, a integração retorna dados mock claramente
# identificados como tal. Preencha só depois de escolher e ler a
# documentação de um provedor real.)
RAPIDAPI_1688_KEY=

# Email (opcional — sem isso, os emails só são logados no console em vez
# de enviados de verdade. Ver lib/email-templates.ts.)
RESEND_API_KEY=

